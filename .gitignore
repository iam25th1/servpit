# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# asset archives and macOS zip cruft (never commit; extraction stages then deletes)
*.zip
__MACOSX/

# Next.js dev regenerates these agent docs (they contain em dashes); never commit them
/AGENTS.md
/CLAUDE.md

# runtime state: wallet address registry, transfer ledger, round records
/data/
